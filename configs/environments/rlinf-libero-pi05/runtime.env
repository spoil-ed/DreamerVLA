# Container-visible paths. This file contains no credentials or proxy settings.
HOME=/home/sim
DVLA_ROOT=/workspace/DreamerVLA
DVLA_DATA_ROOT=/runtime/data
HF_HOME=/home/sim/.cache/huggingface
HF_ENDPOINT=https://hf-mirror.com
HF_LEROBOT_HOME=/runtime/data/datasets/lerobot
PI05_BASE_CKPT=/checkpoints/lerobot/pi05_base
PI05_LIBERO_CKPT=/checkpoints/RLinf/RLinf-Pi05-LIBERO-SFT
EMBODIED_PATH=/workspace/RLinf/examples/embodiment
VIRTUAL_ENV=/runtime/venvs/openpi-libero
PATH=/runtime/venvs/openpi-libero/bin:/runtime/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MUJOCO_GL=egl
PYOPENGL_PLATFORM=egl
NVIDIA_DRIVER_CAPABILITIES=all
